# ─────────────────────────────────────────────────────────────────────────────
# Deliver LBH — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string used by lib/db and the API server.
DATABASE_URL=postgresql://user:password@localhost:5432/deliverlbh

# ── API server (required) ────────────────────────────────────────────────────
# Port the Express server listens on. The server throws on startup if unset.
PORT=8080

# Secret used to sign JWTs. The server REFUSES TO START without it.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Node environment (development | production)
NODE_ENV=development

# Optional error monitoring. Set to your Sentry DSN AND install @sentry/node to
# enable; leave empty to disable (errors are still logged).
SENTRY_DSN=

# Set to 1 to disable Expo push delivery (e.g. local dev). Unset = enabled.
PUSH_DISABLED=

# ── Messaging (email / SMS for OTP verification) ─────────────────────────────
# "console" (default) just logs codes (dev). Swap for real providers later.
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# ── Payments ─────────────────────────────────────────────────────────────────
# Mobile-money provider. "mock" (default) is a local sandbox; swap for a real
# DRC adapter (M-Pesa / Airtel / aggregator) once implemented.
PAYMENT_PROVIDER=mock
# Shared secret the provider must send (header x-webhook-secret) on the webhook.
# Leave empty in dev to accept unsigned callbacks.
PAYMENT_WEBHOOK_SECRET=

# ── File storage (images, KYC docs) ──────────────────────────────────────────
# "local" (default) stores under UPLOAD_DIR and serves at PUBLIC_URL/uploads.
# Swap for a cloud driver (s3/cloudinary) once implemented.
STORAGE_DRIVER=local
UPLOAD_DIR=
# Public base URL of the API, used to build absolute upload URLs.
# Defaults to http://localhost:$PORT in dev; set to your API domain in prod.
PUBLIC_URL=

# Comma-separated list of allowed browser origins for CORS (production).
# Leave unset in dev to reflect any origin. Native mobile apps are unaffected.
# Example: CORS_ORIGINS=https://deliver-lbh.app,https://admin.deliver-lbh.app
CORS_ORIGINS=

# ── Admin seed (used by the create-admin script) ─────────────────────────────
# The initial super-admin account. Change the password before running in prod.
ADMIN_EMAIL=admin@deliverlbh.com
ADMIN_PASSWORD=

# ── Mobile app (Expo) ────────────────────────────────────────────────────────
# The domain the mobile app calls; API base URL becomes https://$EXPO_PUBLIC_DOMAIN/api
EXPO_PUBLIC_DOMAIN=localhost:8080

# production | development — controls Expo router origin + build flags
APP_ENV=development
