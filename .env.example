# ─────────────────────────────────────────────────────────────────────────────
# Deliver LBH — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string used by lib/db and the API server.
DATABASE_URL=postgresql://user:password@localhost:5432/deliverlbh

# ── API server (required) ────────────────────────────────────────────────────
# Port the Express server listens on. The server throws on startup if unset.
PORT=8080

# Secret used to sign JWTs. The server REFUSES TO START without it.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Node environment (development | production)
NODE_ENV=development

# Comma-separated list of allowed browser origins for CORS (production).
# Leave unset in dev to reflect any origin. Native mobile apps are unaffected.
# Example: CORS_ORIGINS=https://deliver-lbh.app,https://admin.deliver-lbh.app
CORS_ORIGINS=

# ── Admin seed (used by the create-admin script) ─────────────────────────────
# The initial super-admin account. Change the password before running in prod.
ADMIN_EMAIL=admin@deliverlbh.com
ADMIN_PASSWORD=

# ── Mobile app (Expo) ────────────────────────────────────────────────────────
# The domain the mobile app calls; API base URL becomes https://$EXPO_PUBLIC_DOMAIN/api
EXPO_PUBLIC_DOMAIN=localhost:8080

# production | development — controls Expo router origin + build flags
APP_ENV=development
